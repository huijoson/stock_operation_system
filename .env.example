# Database（必填 — 後端 API / 登入功能皆需要此連線字串）
DATABASE_URL="postgresql://user:password@localhost:5432/stock_portfolio"

# Prisma TLS / SSL（資料庫連線憑證）
# 若 db:migrate 出現 "self-signed certificate in certificate chain"，
# 優先設定 CA 憑證路徑（安全做法）：
# PRISMA_CA_CERT_PATH="/path/to/ca-certificate.crt"
#
# 僅限本機除錯時可暫時略過驗證（勿用於正式環境）：
# PRISMA_ALLOW_INSECURE_TLS="true"

# Stock API Keys (optional, for future use)
YAHOO_FINANCE_API_KEY=""
FINMIND_API_KEY=""

# Cron / Sync
CRON_SECRET=""

# Vite
VITE_APP_URL="http://localhost:3000"
